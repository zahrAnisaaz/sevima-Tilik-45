PORT=3000

# Supabase > Project Settings > Data API (URL) dan API Keys
# URL harus persis https://xxxx.supabase.co (tanpa garis miring di akhir)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=isi_anon_atau_publishable_key
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_atau_secret_key

# Asisten AI (opsional). Tanpa key, Tilik memakai pustaka aktivitas bawaan.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# Kosongkan bila frontend disajikan dari server yang sama (default)
CORS_ORIGIN=
